# ==============================================================================
# Automated Multi-Platform Posting System - Environment Configuration
# ==============================================================================

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=4000
DEBUG=False

# Simulation / Mock Mode
# Set to 'true' to simulate successful responses without requiring live API credentials.
# Set to 'false' (default) to make live HTTP API requests to each configured platform.
MOCK_MODE=false

# ------------------------------------------------------------------------------
# 1. Telegram Bot API Integration
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to obtain your bot token.
# Channel username format: @your_channel or numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. Discord Webhook Integration
# ------------------------------------------------------------------------------
# In Discord channel settings -> Integrations -> Webhooks -> Create Webhook
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. Slack Webhook / Web API Integration
# ------------------------------------------------------------------------------
# Create an Incoming Webhook in Slack App settings, or provide Bot Token + Channel ID
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 4. Mastodon API Integration
# ------------------------------------------------------------------------------
# Any Mastodon instance (e.g., https://mastodon.social).
# Obtain an Access Token under Preferences -> Development -> New Application
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. GitHub Issues / Announcements API Integration
# ------------------------------------------------------------------------------
# Personal Access Token (classic PAT with 'repo' scope, or fine-grained PAT with 'Issues' write)
GITHUB_ACCESS_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ------------------------------------------------------------------------------
# 6. Dev.to Community Portal (Optional / Extra)
# ------------------------------------------------------------------------------
# Obtain API key from https://dev.to/settings/extensions
DEVTO_API_KEY=
DEVTO_ORGANIZATION_ID=
